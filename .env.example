# Copy this file to .env and fill in your own values. Never commit .env.
# Model API key. LLM_API_KEY takes priority; DEEPSEEK_API_KEY is kept for compatibility.
LLM_API_KEY=
# Optional. Default: https://api.deepseek.com/chat/completions
# LLM_BASE_URL=
# Optional. Default: deepseek-flash
# LLM_MODEL=
DEEPSEEK_API_KEY=

# Telegram channel is the default mode. Run with --cli to use the terminal.
# Bot token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Only this user gets a response.
ALLOWED_USER_ID=
